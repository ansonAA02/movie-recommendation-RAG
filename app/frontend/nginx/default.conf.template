server {
    # English comment: Listen on the runtime port inside the container.
    listen ${PORT};
    server_name _;

    # English comment: Serve the built Vite application.
    root /usr/share/nginx/html;
    index index.html;

    # English comment: Proxy backend API calls to the Docker backend service.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # English comment: Fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
