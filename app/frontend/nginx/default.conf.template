server {
    # English comment: Listen on the runtime port inside the container.
    listen ${PORT};
    server_name _;

    # English comment: Serve the built Vite application.
    root /usr/share/nginx/html;
    index index.html;

    # English comment: Proxy backend API calls to the Docker backend service.
    location /api/ {
        # Use resolver to evaluate DNS at runtime, preventing Nginx from crashing on startup if BACKEND_URL is invalid
        resolver 8.8.8.8 1.1.1.1 valid=300s ipv6=off;
        set $backend "${BACKEND_URL}";
        
        proxy_pass $backend;
        proxy_http_version 1.1;
        
        # Enable SNI so HTTPS upstreams (like Railway) can route the request correctly
        proxy_ssl_server_name on;
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # English comment: Fall back to index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
